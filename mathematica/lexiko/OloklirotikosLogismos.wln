    "Notebook" -> "59980467-dc44-4746-956f-fd1e111f7b0d"|>, 
   <|"Data" -> "Clear[\"Global`*\"]\n\nRiemannBar[box : {{x0_, x1_}, {y0_, \
y1_}}, {x_, y_}, _] := \n Block[{area = (y1 + y0) (x1 - x0)},  Sow[area];\n  \
{ChartElementData[\"Rectangle\"][box, {}, {}], {Opacity[1], Black, Point[{x, \
y}]}, \n  If[Abs[area] < 10^-2, {}, {Opacity[1], \
Black,Rotate[Text[ToString[NumberForm[area, {Infinity, 2}]], Mean /@ box], \
Pi/2, Mean /@ box]}]}]", "Display" -> "codemirror", 
    "Hash" -> "3f5d20df-6e7a-4367-beb6-4afb2d7bded6", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Input", "UID" -> Null, 
    "Notebook" -> "59980467-dc44-4746-956f-fd1e111f7b0d"|>, 
   <|"Data" -> "RiemannPlot[f_, {x_, x0_, x1_, dx_: 1.}, opts___] := \n \
Block[{plot, areas, extent, points, curve},\n  extent = \
OptionValue[Flatten[{opts}], ExtentSize];\n  points = \n   If[IntegerQ[dx], \
RandomReal[{x0, x1}, dx], \n    Switch[extent, Full, Range[x0, x1, dx], Left, \
\n     Range[x0 + dx, x1, dx], Right, Range[x0, x1 - dx, dx]]]; {plot, \n    \
areas} = \n   Reap[DiscretePlot[f, Evaluate@{x, points}, opts, ImageSize -> \
475, \n     ExtentElementFunction -> RiemannBar, \n     FillingStyle -> \
Opacity[0.5],  PlotStyle -> PointSize[Small]]];\n  Show[plot, Plot[f, {x, x0, \
x1}], \n   PlotLabel -> \n    ToString@Row[{\"Estimated Area: \", \
Total[Flatten@areas], \"; \" \n      \"Actual Area: \", NIntegrate[f, {x, x0, \
x1}]}], Frame -> True,   PlotRange -> All, Axes -> {True, False}]  ]", 
    "Display" -> "codemirror", "Hash" -> 
