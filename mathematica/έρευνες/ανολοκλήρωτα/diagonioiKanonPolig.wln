   <|"Data" -> "(*VB[*)(FrontEndRef[\"44729926-5a65-40a8-a106-90f024688bcf\"]\
)(*,*)(*\"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgEKm5iYG\
1laGpnpmiaameqaGCRa6CYaGpjpWhqkGRiZmFlYJCWnAQBq4xS6\"*)(*]VB*)", 
    "Display" -> "codemirror", "Hash" -> 
     "acd6a785-51d4-487b-9a2e-0dde444fa39f", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "1e817949-64ef-47fb-8e69-14a3d14fa90e"|>, 
   <|"Data" -> "Clear[\"`*\"];\neqT = (y - Sin[t1]) (Cos[t2] - Cos[t1]) == (x \
- Cos[t1]) (Sin[t2] - Sin[t1]);\neqW = (y - Sin[w1]) (Cos[w2] - Cos[w1]) == \
(x - Cos[w1]) (Sin[w2] - Sin[w1]);\nsol = Solve[{eqT, eqW}, {x, y}];\nxSol = \
x /. sol[[1]][[1]];\nx0[t1_, t2_, w1_, w2_] := Evaluate[xSol]\nySol = y /. \
sol[[1]][[2]];\ny0[t1_, t2_, w1_, w2_] := \
Evaluate[ySol]\nn=10000;\ncirclePoints = RandomReal[2Pi,{n,4}];\nxPoints = x0 \
@@@ circlePoints;\nyPoints = y0 @@@ circlePoints;\npoints = \
Transpose[{xPoints,yPoints}];\na=2;\nListPlot[points, PlotRange -> \
{{-a,a},{-a,a}}, AspectRatio ->1]\nDensityHistogram[points, \
Automatic,\"PDF\"]\nHistogram3D[points, Automatic,\"PDF\"]//MMAView", 
