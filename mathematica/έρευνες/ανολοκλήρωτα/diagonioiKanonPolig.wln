    "Display" -> "codemirror", "Hash" -> 
     "398c1bb7-ef61-4716-a823-49387ab76c72", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Input", "UID" -> Null, 
    "Notebook" -> "1e817949-64ef-47fb-8e69-14a3d14fa90e"|>, 
   <|"Data" -> "\n# \
\[CapitalDelta]\[Iota]\[Alpha]\[Gamma]\:03ce\[Nu]\[Iota]\[Omicron]\[Iota] \
\[Kappa]\[Alpha]\[Nu]\[Omicron]\[Nu]\[Iota]\[Kappa]\[Omicron]\:03cd \
\[Pi]\[Omicron]\[Lambda]\[Upsilon]\[Gamma]\:03ce\[Nu]\[Omicron]\[Upsilon]", 
    "Display" -> "markdown", "Hash" -> 
     "f9f3ae6b-3325-4cb0-8372-1e9e2a5cec05", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "1e817949-64ef-47fb-8e69-14a3d14fa90e"|>, 
   <|"Data" -> "Clear[\"`*\"];\nn = 27;\npts = CirclePoints[N@n];\npack = \
Developer`ToPackedArray;\ndiag = Join @@ \n    Table[pts[[{i, j}]], {i, n - \
2}, {j, i + 2, n - Boole[i < 2]}] // \n   pack;\nlineIntersection = \n  \
Partition[Indexed[T, #] & /@ Tuples[{1, 2}, 3], \n    2] /. {a_, b_, c_, d_} \
:> \n    Compile[{{T, _Real, \n       3}}, (Det[{a, b}] (c - d) - \n         \
Det[{c, d}] (a - b))/(Det[{a - b, c - d}] - 5*^-15) // \n      Evaluate, \
RuntimeAttributes -> {Listable}];\nLength[intersectionPts = \n  Subsets[diag, \
{2}] // pack // lineIntersection // \n    Pick[#, Unitize[Sqrt[(#^2) . {1, \
1}], 1], 0] & // \n   Nearest[#, DeleteDuplicates[Round[#, 10.^-8]], 1][[All, \
1]] &]\ncenter = Mean[pts];\nradius = Max[Norm[# - center] & /@ \
pts];\nGraphics[{Line /@ diag, {Red, PointSize[Small], \n   \
Point@intersectionPts}, {Blue, Circle[center, radius]}}, \n ImageSize -> \
Large, \n PlotLabel -> \n  \
\"\[CapitalSigma]\[Eta]\[Mu]\[CurlyEpsilon]\:03af\[Alpha] \
\[Tau]\[Omicron]\[Mu]\:03ae\[FinalSigma] \
\[Delta]\[Iota]\[Alpha]\[Gamma]\[Omega]\[Nu]\:03af\[Omega]\[Nu] \
\[Kappa]\[Alpha]\[Nu]\[Omicron]\[Nu]\[Iota]\[Kappa]\[Omicron]\:03cd \" <> \
ToString[n] <> \"-\[Gamma]\:03ce\[Nu]\[Omicron]\[Upsilon]\"]//MMAView", 
